# ---------- Cloud ----------
PORT=3000
# Use 127.0.0.1 with Tailscale Serve (recommended). Use 0.0.0.0 for direct LAN/Tailscale HTTP access.
# Docker Compose overrides HOST to 0.0.0.0 and moves DB_PATH/LOG_DIR/ADMIN_TOKEN_FILE
# into the /data volume, so the values below are only used for non-container runs.
HOST=127.0.0.1
DB_PATH=./data/twitchpc.db
# If empty, a token is generated in data/admin-token.txt and printed once at startup.
# In Docker that file is /data/admin-token.txt inside the twitchpc-data volume.
ADMIN_TOKEN=
ADMIN_TOKEN_FILE=
COMMAND_TIMEOUT_MS=30000
LOG_DIR=
RELEASE_DIR=./release
DEFAULT_AGENT_ID=default

# Twitch app (https://dev.twitch.tv/console/apps)
# Register https://localhost:3001/callback as the OAuth Redirect URL, then run
# `npm run token:user` and `npm run token:bot` to generate the tokens below.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Broadcaster user id and login the events are read from
TWITCH_BROADCASTER_ID=
TWITCH_BROADCASTER_LOGIN=
# Optional: long-lived user token + refresh token (scopes below)
TWITCH_BROADCASTER_ACCESS_TOKEN=
TWITCH_BROADCASTER_REFRESH_TOKEN=
# Optional: override client-credentials token (normally fetched automatically)
TWITCH_APP_TOKEN=

# Bot account used for !commands in chat (token WITHOUT "oauth:" prefix)
TWITCH_BOT_TOKEN=
TWITCH_BOT_USERNAME=
CHAT_COMMAND_PREFIX=!

# Optional shared fallback secret. If empty, use the dashboard's Pair agent flow
# to give each agent its own token. AGENT_TOKEN is still accepted for existing setups.
AGENT_TOKEN=
WEBHOOK_TIMEOUT_MS=10000

# ---------- Local agent (on the streamer's PC) ----------
# Use wss://<host>.<tailnet>.ts.net/agent with Tailscale Serve (recommended).
# For direct Tailscale HTTP without Serve: ws://<magicdns-host>:3000/agent
CLOUD_URL=wss://my-machine.my-tailnet.ts.net/agent
AGENT_ID=default
# Recommended: generate a code in the dashboard and paste it into the tray app
# prompt when it appears. It saves AGENT_TOKEN and connects without a restart.
# You can also paste the code here before the first start (legacy/file flow).
PAIRING_CODE=
# Or set a token manually (must match the cloud's AGENT_TOKEN if that is used):
AGENT_TOKEN=
# Exact executable names/paths the cloud may ask the agent to launch, comma-separated
EXEC_ALLOWLIST=notepad.exe,C:\Program Files\obs-studio\bin\64bit\obs64.exe
# Exact command lines the cloud may ask cmd.exe to run, separated with | (or newlines).
# Windows shell commands are allowed here; nothing outside this list is executed.
# Example: CMD_ALLOWLIST=shutdown /s /t 0|echo hello
CMD_ALLOWLIST=
CMD_TIMEOUT_MS=15000
OBS_WS_URL=ws://localhost:4455
OBS_PASSWORD=
HEARTBEAT_INTERVAL_MS=15000
RECONNECT_DELAY_MS=3000
AGENT_AUTO_UPDATE=true
# Local-only HTTP port used by the Windows tray app for status/pause/resume.
AGENT_CONTROL_PORT=4310
# Set automatically by "TwitchPC Agent.exe"; no need to edit manually.
# AGENT_SUPERVISED=true
